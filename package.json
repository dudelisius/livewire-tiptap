{
    "dependencies": {
        "@popperjs/core": "2",
        "@tailwindcss/cli": "^4.1.18",
        "@tailwindcss/vite": "^4.1.18",
        "@tiptap/core": "^2.27.2",
        "@tiptap/extension-blockquote": "^2.27.2",
        "@tiptap/extension-emoji": "^2.27.2",
        "@tiptap/extension-hard-break": "^2.27.2",
        "@tiptap/extension-highlight": "^2.27.2",
        "@tiptap/extension-horizontal-rule": "^2.27.2",
        "@tiptap/extension-link": "^2.27.2",
        "@tiptap/extension-subscript": "^2.27.2",
        "@tiptap/extension-superscript": "^2.27.2",
        "@tiptap/extension-text-align": "^3.15.3",
        "@tiptap/extension-underline": "^2.27.2",
        "@tiptap/extension-youtube": "^2.27.2",
        "@tiptap/extensions": "^3.15.3",
        "@tiptap/starter-kit": "^2.27.2",
        "alpinejs": "^3.15.3",
        "tailwindcss": "^4.1.18",
        "tippy.js": "6"
    },
    "scripts": {
        "build:css": "tailwindcss -i resources/css/livewire-tiptap.css -o dist/livewire-tiptap.css --minify",
        "build:js": "esbuild resources/js/livewire-tiptap.js --bundle --minify --outfile=dist/livewire-tiptap.js",
        "build": "bun run build:css && bun run build:js",
        "sync:pegasus": "bun run build && php ../pegasus/artisan vendor:publish --tag=livewire-tiptap-assets --force && php ../pegasus/artisan optimize:clear",
        "dev": "bun run sync:pegasus && chokidar \"resources/css/**/*\" \"resources/js/**/*\" \"resources/views/**/*\" \"src/**/*\" \"config/**/*\" -i \"dist/**/*\" -i \"**/node_modules/**\" -i \"**/vendor/**\" -i \"**/.git/**\" -c \"bun run sync:pegasus\""
    },
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "esbuild": "^0.25.12"
    }
}
